# Copy to apps/api/.env and fill in real values. NEVER commit secrets.

# MongoDB connection string (no trailing db name; app appends /agentic_commerce)
MONGODB_URL=mongodb://localhost:27017

# Secret for JWT auth cookies
JWT_SECRET=change_me

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# Google AI API key (Gemini). Free tier: ~20 req/day/model.
GOOGLE_API_KEY=

# Optional model override (default shown). The frontend dropdown sends any safe
# gemini-* id per message; unknown ids fall back to GEMINI_MODEL.
# GEMINI_MODEL=gemini-3.1-flash-lite

# Swiggy Builders exchange token (web/cap client). The chat connects the user to
# Swiggy via the OAuth modal (swiggy/connect → callback → token storage).
SWIGGY_API_KEY=

# Razorpay merchant account (Dashboard → Settings → API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay webhook secret (Dashboard → Settings → Webhooks).
# Register POST {PUBLIC_URL}/payments/webhook with event payment.captured.
RAZORPAY_WEBHOOK_SECRET=